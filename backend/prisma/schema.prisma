generator client { 
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Model (Handles Admin, Teacher, Student RBAC)
enum Role {
    ADMIN 
    TEACHER 
    STUDENT 
}

model User {
    id        String   @id @default(uuid())
    clerkId   String   @unique
    email     String   @unique
    name      String
    role      Role     @default(STUDENT)

    // Relations
    examsCreated     Exam[]            @relation("TeacherExams")
    results          Result[]
    examAssignments  ExamAssignment[]

    // Report Fields
    prn              String?
    year             String?
    department       String?

    createdAt        DateTime          @default(now())

    @@index([clerkId])
}

// 2. Exam Status Enum
enum ExamStatus {
    DRAFT
    PUBLISHED
    ACTIVE
    CLOSED
}

// 3. Exam Model (Managed by Teachers)
model Exam {
  id          String     @id @default(uuid())
  title       String
  description String?
  startTime   DateTime?
  endTime     DateTime?
  duration    Int        // Duration in minutes
  totalMarks  Int
  passPercent Float      @default(40)
  negativeMarking Boolean @default(false)
  status      ExamStatus @default(DRAFT)
  teacherId   String
  teacher     User       @relation("TeacherExams", fields: [teacherId], references: [id])
  
  // Relations
  questions   Question[]
  results     Result[]
  assignments ExamAssignment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([teacherId])
  @@index([status])
}

// 4. Exam Assignment - links students to exams
model ExamAssignment {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([examId, studentId])
  @@index([studentId])
}

// 5. Question Model (Supports both MCQ and Coding)
enum QuestionType {
  MCQ
  CODING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  type          QuestionType
  text          String
  marks         Int
  difficulty    Difficulty   @default(MEDIUM)
  order         Int          @default(0)
  
  // Relations (Only one of these will be populated based on QuestionType)
  mcqOptions    McqOption[]
  testCases     TestCase[]

  @@index([examId])
}

// 6. MCQ Options (For Multiple Choice Questions)
model McqOption {
  id          String   @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean  @default(false)
}

// 7. Test Cases (For Coding Challenges)
model TestCase {
  id             String   @id @default(uuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isVisible      Boolean  @default(true)
}

// 8. Result Status Enum
enum ResultStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

// 9. Results & Analytics Model
model Result {
  id             String       @id @default(uuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id])
  examId         String
  exam           Exam         @relation(fields: [examId], references: [id])
  
  totalScore     Int          @default(0)
  maxScore       Int          @default(0)
  percentage     Float        @default(0)
  passed         Boolean      @default(false)
  status         ResultStatus @default(IN_PROGRESS)
  tabSwitches    Int          @default(0)
  answers        Json?        // Stores student answers as JSON
  performanceLog Json?
  
  // Analytics Fields
  grade          String?
  percentile     Float?
  rank           Int?
  timeTaken      Int          @default(0) // In seconds
  
  submittedAt    DateTime?
  createdAt      DateTime     @default(now())

  // Relations for reporting
  sectionResults  SectionResult[]
  questionResults QuestionResult[]

  @@index([studentId, examId])
  @@index([examId])
}

// 10. Section-wise results (Normalized for reports)
model SectionResult {
  id          String       @id @default(uuid())
  resultId    String
  result      Result       @relation(fields: [resultId], references: [id], onDelete: Cascade)
  sectionType QuestionType
  score       Int
  maxMarks    Int
  createdAt   DateTime     @default(now())

  @@index([resultId])
}

// 11. Question-wise results (Normalized for reports)
model QuestionResult {
  id             String       @id @default(uuid())
  resultId       String
  result         Result       @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId     String
  type           QuestionType
  selectedAnswer String?      // For MCQ: optionId, For Coding: code
  correctAnswer  String?      // Reference for report
  marks          Int
  status         String       // CORRECT, INCORRECT, PARTIAL
  createdAt      DateTime     @default(now())

  @@index([resultId])
}